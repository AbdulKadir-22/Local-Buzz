@using LocalBuzz.Services
@model LocalBuzz.ViewModels.ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="lb-alert lb-alert-error"></div>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
    <!-- Name -->
    <div class="lb-form-group">
        <label asp-for="Name" class="lb-label"></label>
        <input asp-for="Name" class="lb-input" placeholder="e.g. Logitech M170 Wireless Mouse" required />
        <span asp-validation-for="Name" class="lb-input-error"></span>
    </div>

    <!-- Brand -->
    <div class="lb-form-group">
        <label asp-for="Brand" class="lb-label"></label>
        <input asp-for="Brand" class="lb-input" placeholder="e.g. Logitech, Samsung, Nike" />
        <span asp-validation-for="Brand" class="lb-input-error"></span>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap: 16px;">
    <!-- Category -->
    <div class="lb-form-group">
        <label asp-for="Category" class="lb-label"></label>
        <select asp-for="Category" class="lb-select" required>
            @foreach (var cat in CategoryCatalog.Categories)
            {
                <option value="@cat.Name">@cat.Emoji @cat.Name</option>
            }
        </select>
        <span asp-validation-for="Category" class="lb-input-error"></span>
    </div>

    <!-- Price -->
    <div class="lb-form-group">
        <label asp-for="Price" class="lb-label"></label>
        <input asp-for="Price" type="number" step="0.01" class="lb-input" placeholder="e.g. 499.00" required />
        <span asp-validation-for="Price" class="lb-input-error"></span>
    </div>
</div>

<!-- Description -->
<div class="lb-form-group">
    <label asp-for="Description" class="lb-label"></label>
    <textarea asp-for="Description" class="lb-textarea" rows="3" placeholder="Key specs, warranty, features, or pack sizes..."></textarea>
    <span asp-validation-for="Description" class="lb-input-error"></span>
</div>

<!-- Image Upload & Preview -->
<div class="lb-form-group">
    <label asp-for="ImageFile" class="lb-label"></label>
    
    @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
    {
        <div style="display:flex; align-items:center; gap:16px; margin-bottom:12px; background:#faf8f3; padding:10px; border-radius:10px;">
            <img src="@Model.ExistingImagePath" alt="Current image" style="width:70px; height:70px; object-fit:cover; border-radius:8px;" />
            <div style="font-size:0.85rem; color:var(--lb-muted);">
                <strong>Current Image</strong><br />
                Upload a new image below if you want to replace it.
            </div>
        </div>
    }

    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="lb-input" />
    <span asp-validation-for="ImageFile" class="lb-input-error"></span>
    <small style="display:block; color:var(--lb-muted); font-size:0.8rem; margin-top:4px;">
        Max 2 MB. Supported formats: .jpg, .jpeg, .png, .webp. Leave empty to use category placeholder.
    </small>
</div>

<!-- Availability -->
<div class="lb-form-group">
    <label class="lb-checkbox-label">
        <input asp-for="IsAvailable" class="lb-checkbox" type="checkbox" />
        <span>Available in stock for local customers</span>
    </label>
</div>
