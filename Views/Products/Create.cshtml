@model LocalBuzz.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Add New Product";
}

<div style="max-width: 680px; margin: 1.5rem auto;">
    <div style="margin-bottom: 1.25rem;">
        <a href="/Products" class="lb-explore-link">← Back to Product List</a>
    </div>

    <div class="lb-card" style="padding: 2rem;">
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-top: 0; margin-bottom: 1.5rem;">
            Add New Product
        </h1>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_ProductForm" model="Model" />

            <div style="display:flex; gap:12px; margin-top:1.5rem;">
                <button type="submit" class="lb-btn lb-btn-accent" style="min-height:46px; padding-left:1.5rem; padding-right:1.5rem;">
                    Save & Add Product
                </button>
                <a href="/Products" class="lb-btn lb-btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
